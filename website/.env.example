# 웹사이트 빌드 환경변수 (전부 선택 사항 — 없으면 site.config.json 값을 사용)
#
# ⚠ 여기에는 비밀 값을 넣지 마세요. 이 값들은 전부 정적 HTML에 그대로 들어갑니다.
#    SignPath API 토큰이나 GitHub 개인 토큰은 절대 넣지 마세요.
#    (그런 값은 GitHub Actions Secret으로만 관리합니다)

# 사이트가 배포될 주소. 도메인을 연결하면 https://diagbench.com 등으로 바꾸세요.
SITE_URL=https://OWNER.github.io/diag-bench

# GitHub 저장소 정보. Actions에서는 자동으로 채워지므로 로컬 테스트용입니다.
GITHUB_OWNER=OWNER
GITHUB_REPOSITORY_NAME=diag-bench

# 분석 도구 측정 ID (선택). 비워두면 분석 스크립트가 아예 삽입되지 않습니다.
ANALYTICS_ID=

# 로컬에서 API rate limit을 피하려면 read-only 토큰을 넣을 수 있습니다(선택).
# GITHUB_TOKEN=
